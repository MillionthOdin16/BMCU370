From 639daffca30127d725670b21b401ca35c4257cb4 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 13 Dec 2025 03:02:56 +0000
Subject: [PATCH] Add BMCU370t code improvements (safe subset)

- Add centralized config.h with all hardware constants
- Add DEBUG_float() support for floating-point debugging
- Improve debug macro hygiene (do/while wrapping)
- Use config.h constants for baud rate

All existing bug fixes from BMCU370 are preserved.
---
 bmcu370t-safe-improvements.patch | 335 +++++++++++++++++++++++++++++++
 src/Debug_log.cpp                |  29 +++
 src/Debug_log.h                  |  40 ++--
 src/config.h                     | 199 ++++++++++++++++++
 4 files changed, 585 insertions(+), 18 deletions(-)
 create mode 100644 bmcu370t-safe-improvements.patch
 create mode 100644 src/config.h

diff --git a/bmcu370t-safe-improvements.patch b/bmcu370t-safe-improvements.patch
new file mode 100644
index 0000000..7a938a6
--- /dev/null
+++ b/bmcu370t-safe-improvements.patch
@@ -0,0 +1,335 @@
+From: Claude AI Assistant
+Subject: [PATCH] Add BMCU370t code improvements while preserving bug fixes
+
+This patch adds key code improvements from BMCU370t:
+1. Centralized configuration (config.h)
+2. Enhanced debugging with DEBUG_float support
+3. Better macro hygiene for debug macros
+4. Uses config constants for maintainability
+
+All existing bug fixes from BMCU370 are preserved.
+
+---
+ src/Debug_log.cpp |  37 ++++++++
+ src/Debug_log.h   |  37 +++++---
+ src/config.h      | 199 ++++++++++++++++++++++++++++++++++++++++++++
+ 3 files changed, 261 insertions(+), 12 deletions(-)
+ create mode 100644 src/config.h
+
+diff --git a/src/Debug_log.cpp b/src/Debug_log.cpp
+index 79508de..fa04354 100644
+--- a/src/Debug_log.cpp
++++ b/src/Debug_log.cpp
+@@ -1,5 +1,7 @@
+ #include "Debug_log.h"
+ #include <inttypes.h>
++#include <stdio.h>
++#include <string.h>
+
+ #ifdef Debug_log_on
+ uint32_t stack[1000];
+@@ -86,6 +88,41 @@ void Debug_log_write_num(const void *data, int num)
+     USART_DMACmd(USART3, USART_DMAReq_Tx, ENABLE);
+ }
+
++void Debug_log_write_float(const void *prefix, float value, int precision)
++{
++    char buffer[32];
++    int prefix_len = strlen((const char*)prefix);
++    memcpy(buffer, prefix, prefix_len);
++
++    // Convert float to string with specified precision
++    int int_part = (int)value;
++    float frac_part = value - int_part;
++    if (frac_part < 0) frac_part = -frac_part;
++
++    int len = sprintf(buffer + prefix_len, "%d", int_part);
++    if (precision > 0) {
++        buffer[prefix_len + len] = '.';
++        len++;
++        for (int i = 0; i < precision; i++) {
++            frac_part *= 10;
++            int digit = (int)frac_part;
++            buffer[prefix_len + len + i] = '0' + digit;
++            frac_part -= digit;
++        }
++        len += precision;
++    }
++
++    Debug_log_write_num(buffer, prefix_len + len);
++}
++
+ void USART3_IRQHandler(void)
+ {
+     if (USART_GetITStatus(USART3, USART_IT_RXNE) != RESET)
+diff --git a/src/Debug_log.h b/src/Debug_log.h
+index bf93f29..2d057be 100644
+--- a/src/Debug_log.h
++++ b/src/Debug_log.h
+@@ -1,37 +1,50 @@
+ #pragma once
+
+ #include "main.h"
++#include "config.h"
++
++// Debug logging configuration
+ #define Debug_log_on
+-#define Debug_log_baudrate 115200
++#define Debug_log_baudrate DEBUG_UART_BAUDRATE
+
+ #ifdef __cplusplus
+ extern "C"
+ {
+ #endif
+     extern void Debug_log_init();
+     extern uint64_t Debug_log_count64();
+     extern void Debug_log_time();
+     extern void Debug_log_write(const void *data);
+     extern void Debug_log_write_num(const void *data, int num);
+-#define DEBUG_time_log() ;
++    extern void Debug_log_write_float(const void *prefix, float value, int precision);
++
+ #ifdef Debug_log_on
+-#define DEBUG_init() Debug_log_init()
+-#define DEBUG_MY(logs) Debug_log_write(logs)
+-#define DEBUG_num(logs, num) Debug_log_write_num(logs, num)
+-#define DEBUG_time() Debug_log_time()
+-#define DEBUG_get_time() Debug_log_count64()
++    #define DEBUG_init() Debug_log_init()
++    #define DEBUG_MY(logs) Debug_log_write(logs)
++    #define DEBUG_num(logs, num) Debug_log_write_num(logs, num)
++    #define DEBUG_float(logs, precision) Debug_log_write_float("", logs, precision)
++    #define DEBUG_time() Debug_log_time()
++    #define DEBUG_get_time() Debug_log_count64()
++    #define DEBUG_time_log() DEBUG_time()
+ #else
+-#define DEBUG_init() ;
+-#define DEBUG(logs) \
+-    ;               \
+-    ;
+-#define DEBUG_num(logs, num) \
+-    ;                        \
+-    ;
+-#define DEBUG_time() \
+-    ;                \
+-    ;
++    #define DEBUG_init() do {} while(0)
++    #define DEBUG_MY(logs) do {} while(0)
++    #define DEBUG_num(logs, num) do {} while(0)
++    #define DEBUG_float(logs, precision) do {} while(0)
++    #define DEBUG_time() do {} while(0)
++    #define DEBUG_get_time() (0ULL)
++    #define DEBUG_time_log() do {} while(0)
+ #endif
++
+ #ifdef __cplusplus
+ }
+ #endif
