+// AS5600 Hall sensor I2C pins
+#define AS5600_SCL_PINS         {PB15, PB14, PB13, PB12}  ///< SCL pins for each channel
+#define AS5600_SDA_PINS         {PD0, PC15, PC14, PC13}   ///< SDA pins for each channel
+
